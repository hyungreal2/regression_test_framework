\o
\p

\i envLoadFile("../../code/.cdsenv")
\i load("../../code/perfFunctions.il")
\i code_path = "../../code/"
\i result_path = "../../result/"
\i load( strcat( code_path "date_virtuosoVer.il"))
\i ;;; [EQUIV] legacy 등가화: revertICM 경로를 비활성화하고 legacy 의 ICM GUI 로직을 복원했다.
\i ;;;         아래 load 와 2개 호출은 되살릴 수 있도록 주석으로 보존한다.
\i ;;; load( strcat( code_path "copyHierToEmpty_revertICM.il"))
\i ddAutoCtlSetVars(0 0 3 3)
\i ;--------------------------------------------------
\i ;# Start Time ;# Open Design
\i ;--------------------------------------------------
\i openDesign("a")
\i
\i ;--------------------------------------------------
\i ;# Set Samsung Setting
\i ;--------------------------------------------------
\i LoadSamsungEnv()
\i hiFormDone(schSRCForm)
\i hiCloseWindow(geGetCellViewWindow(gec()))
\i hiDBoxOK(geDBox)
\i
\i ;---------------------------------------------------------------------------------------
\i ;# Deleting cells in Replace_Lib_here_COPY if exits before execute copy operation.
\i ;# [EQUIV] legacy 에는 복사 전 사전 정리 단계가 없다 (legacy copyHierToEmpty:1-26 참조).
\i ;#         등가화를 위해 비활성화. 복사 전 상태 보장이 필요하면 되살릴 것.
\i ;---------------------------------------------------------------------------------------
\i ;;; managed=""
\i ;;; copyHierToEmpty_revertICM("Replace_Lib_here_COPY", managed)
\i
\i ;--------------------------------------------------
\i ;# #Test6_Replace_Lib_here: Copy Hierarchy to empty library
\i ;--------------------------------------------------
\i t1=getCurrentTime()
\i HierCopy("Replace_Lib_here" "Replace_Cell_here" "" "Replace_Lib_here_COPY" list("DRAMLIB"))
\i hiDBoxUser(ICM_intHierQuestion nil 1)
\i
\i ;--------------------------------------------------
\i ;# End Time
\i ;--------------------------------------------------
\i t2=getCurrentTime()
\i final=compareTime(t2 t1)
\i
\i managed=""
\i
\i unique_result_folder = strcat( result_path CDS_PV_REG_RES_NO)
\i system(strcat("mkdir -p " unique_result_folder ))
\i fd=outfile(strcat(unique_result_folder "/Test6_Replace_Lib_here_" managed "_" virtuosoVer() ".log") "w")
\i fprintf(fd "Test6_Replace_Lib_here. Performance Copy Hierarchy to empty library  %s time %d\n" managed final)
\i close(fd)
\i
\i ;---------------------------------------------------------------------------------
\i ;# Deleting cells to make empty Replace_Lib_here_COPY after copy operation.
\i ;# [EQUIV] legacy copyHierToEmpty:44-58 의 ICM GUI 로직을 복원했다.
\i ;#         prod 의 대체 호출은 아래 주석으로 보존한다.
\i ;;; copyHierToEmpty_revertICM("Replace_Lib_here_COPY", managed)
\i ;---------------------------------------------------------------------------------
if(managed=="managed" then
\i ICM_Sensitivity_popup("popup_L" "Replace_Lib_here_COPY" "" "" "" "")
\i ICM_Delete_Lib("ICMDeleteLIB" "Replace_Lib_here_COPY" "" "" "" "")
\i hiDBoxUser(ICM_delLibQuery nil 3)
\i hiDBoxUser(ICM_intHierOkay nil 1)
\i ddDeleteObj(ddGetObj("Replace_Lib_here_COPY" "" "" "data.dm"))
)
\i hiDBoxUser(ICM_delLibQuery nil 3)
\i hiDBoxUser(ICM_intHierOkay nil 1)
\i
\i cells = ddGetObj( "Replace_Lib_here_COPY" )~>cells
\i foreach(cell cells ddDeleteObj(cell))
\i
\i ;--------------------------------------------------
\i ;# Exit
\i ;--------------------------------------------------
\i exit
\i geSaveAllForm->none->value= t
\i hiFormDone(geSaveAllForm)
