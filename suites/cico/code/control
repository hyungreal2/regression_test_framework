# cico step vocabulary for generate_templates.py (cico mode).
# Block-format conversion of the legacy 1_cico_sp/code/control: each legacy
# '<stmt> "\n" <stmt> ... -> <name>' line became '=== Start : <name>',
# one SKILL statement per line, '=== End'. Step names must match code/list.
# Lines outside a block (like these) are ignored.

=== Start : auto checkout on, auto checkin on
ddAutoCtlSetVars(0 0 3 3)
=== End

=== Start : auto checkout on, auto checkin off
ddAutoCtlSetVars(0 0 3 0)
=== End

=== Start : auto checkout off, auto checkin on
ddAutoCtlSetVars(0 0 0 3)
=== End

=== Start : auto checkout off, auto checkin off
ddAutoCtlSetVars(0 0 0 0)
=== End

=== Start : Fast Checkout
ICM_Sensitivity_popup( "popup_L" "libname" "" "" "" "" )
ICM_Checkout_Lib( "ICMFastCoLib" "libname" "" "" "" "" )
hiDBoxUser(ICM_intHierQuestion nil 2)
hiDBoxUser(ICM_intHierOkay nil 1)
ICM_runP4("opened ... | wc -l")
openedPreCnt=atoi(car(last(parseString(ICM_IPCBuffer "\n"))))
win=deOpen(list(nil 'libName "libname" 'cellName "cellname" 'viewName "schematic") nil "a")
when(win==nil fprintf(fd "RowNo_libname_cellname: Open Editor FAIL, exiting...\n")
exit()
geSaveAllForm->none->value= t
hiFormDone(geSaveAllForm))
cv=gec()
id=cv~>view
rval_CO=Validate_fastCO("libname")
fprintf(fd "RowNo_libname_cellname: %s\n" if(rval_CO then "Fast Checkout opened count PASS" else "Fast Checkout opened count FAIL"))
=== End

=== Start : Open-triggered Checkout
win=deOpen(list(nil 'libName "libname" 'cellName "cellname" 'viewName "schematic") nil "a")
when(win==nil fprintf(fd "RowNo_libname_cellname: Open Editor FAIL, exiting...\n")
exit()
geSaveAllForm->none->value= t
hiFormDone(geSaveAllForm))
cv=gec()
id=cv~>view
rval=Validate(id "gdmStateCO" "1")
fprintf(fd "RowNo_libname_cellname: %s\n" if(rval then "Open-triggered Check out PASS" else "Open-triggered Check out FAIL"))
=== End

=== Start : Open-triggered Checkout Expect Fail
win=deOpen(list(nil 'libName "libname" 'cellName "cellname" 'viewName "schematic") nil "a")
hiDBoxCancel(_schDBox)
if(gec() then fprintf(fd "RowNo_libname_cellname: deOpen UNEXPECTED open FAIL\n") else fprintf(fd "RowNo_libname_cellname: deOpen unsucessful PASS\n") win=deOpen(list(nil 'libName "libname" 'cellName "cellname" 'viewName "schematic") nil "r"))
cv=gec()
id=cv~>view
rval=Validate(id "gdmStateCI" "1")
fprintf(fd "RowNo_libname_cellname: %s\n" if(rval then "Open-triggered Check out EXPECTED CI PASS" else "Open-triggered Check out UNEXPECTED CO FAIL"))
=== End

