# ----------------------------------------
# Generated documents (not tracked)
# ----------------------------------------
*.pdf

# ----------------------------------------
# Sensitive config
# ----------------------------------------
**/code/env.csh
**/code/env_sample.sh

# ----------------------------------------
# Runtime outputs
# ----------------------------------------
# Regression directories
regression_test_*/
regression_num.txt
regression_num_*.txt

# Log directory
CDS_log/

# Execution logs
log/

# Replay files (generated by generate_templates.py)
**/code/replay_files/
**/code/replay_files_*/

# Generated mode-specific templates (generated by func_main.sh via sed)
**/code/func_template_*.il

# Temp file removed at start, but may exist
**/code/date_virtuosoVer.txt

# Workspaces created by gdp build workspace (dry-run level 1)
cico_ws_*/

# perf_main.sh runtime outputs
WORKSPACES_MANAGED/
WORKSPACES_UNMANAGED/
result/
.gdp_ws_lock

# Accumulated perf metrics (trend data, managed outside git)
perf_metrics/

# GenerateReplayScript: templates/createReplay.pl are tracked; generated outputs are not
**/GenerateReplayScript/*.au
**/GenerateReplayScript/lcv.txt

# ICM mock directory for DRY_RUN testing (local only, not tracked)
ICM/

# Deferred-deletion staging area (workspace trash bin)
.trash/

# ----------------------------------------
# Reference snapshots (local only, not tracked)
#   reference/prod/        deployed prod snapshot
#   reference/legacy/      latest legacy (mcr_catdm)
#   reference/legacy.old/  previous legacy copy
reference/

# Python
# ----------------------------------------
__pycache__/
*.pyc
*.pyo

# Editor
*.swp
*.swo
*~

# Deploy output (deploy.sh default target)
build/
