envLoadFile("../../code/.cdsenv")
load("../../code/perfFunctions.il")
code_path = "../../code/"
result_path = "../../result/"
load( strcat( code_path "date_virtuosoVer.il"))
ddAutoCtlSetVars(0 0 3 3)
;--------------------------------------------------
;# Open Design in Edit Mode.
;--------------------------------------------------
openDesign("BM02" "FULLCHIP" "schematic" "a")

;--------------------------------------------------
;# Set Samsung Setting
;--------------------------------------------------
LoadSamsungEnv()
hiFormDone(schSRCForm)
hiCloseWindow(geGetCellViewWindow(gec()))
hiDBoxOK(geDBox)

;--------------------------------------------------
;# Test6_BM02: Copy Hierarchy to empty library
;# Start Time
;--------------------------------------------------
t1=getCurrentTime()
HierCopy("BM02" "FULLCHIP" "" "BM02_COPY" list("DRAMLIB"))
hiDBoxUser(ICM_intHierQuestion nil 1)

;--------------------------------------------------
;# End Time 
;--------------------------------------------------
t2=getCurrentTime()
final=compareTime(t2 t1)
system(strcat("mkdir -p " result_path date_virtuosoVer(code_path) ))  

inport = infile(strcat(code_path "managed.txt"))
gets(managed inport)
managed = substring(managed 1 strlen(managed)-1)
close(inport)

fd=outfile(strcat(result_path date_virtuosoVer(code_path) "/Test6_BM02_" managed "_" date_virtuosoVer(code_path) ".log") "w")
fprintf(fd "Test6_BM02. Performance Copy Hierarchy to empty library  %s time %d\n" managed final)
close(fd)

;---------------------------------------------------------------------------------
;# Deleting cells to make empty BM02_COPY after copy operation.
;---------------------------------------------------------------------------------
if(managed=="managed" then
\i ICM_Sensitivity_popup("popup_L" "BM02_COPY" "" "" "" "")
\i ICM_Delete_Lib("ICMDeleteLIB" "BM02_COPY" "" "" "" "")
\i hiDBoxUser(ICM_delLibQuery nil 3)
\i hiDBoxUser(ICM_intHierOkay nil 1)
\i ddDeleteObj(ddGetObj("BM02_COPY" "" "" "data.dm"))
)
\i hiDBoxUser(ICM_delLibQuery nil 3)
\i hiDBoxUser(ICM_intHierOkay nil 1)

\i cells = ddGetObj( "BM02_COPY" )~>cells
\i foreach(cell cells ddDeleteObj(cell))

;--------------------------------------------------
;# Exit
;--------------------------------------------------
exit
geSaveAllForm->none->value= t
hiFormDone(geSaveAllForm)
